# Works without keys using clearly labeled synthetic market data.
PORT=3000
DATA_MODE=demo
# Optional: enable actual multi-role model analysis, including on demo data.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# DATA_MODE=live requires Finnhub for stock quotes, news, and earnings.
FINNHUB_API_KEY=
# Optional custom social sentiment JSON endpoint; see README for schema.
SOCIAL_SENTIMENT_URL=
# Optional endpoint overrides for local provider emulators.
# OPENAI_BASE_URL=http://127.0.0.1:4001/v1
# FINNHUB_BASE_URL=http://127.0.0.1:4002/api/v1
# POLYMARKET_BASE_URL=https://gamma-api.polymarket.com
